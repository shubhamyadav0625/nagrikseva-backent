# Required on Render for real AI analysis
GROQ_API_KEY=your_groq_api_key_here

# Required on Render for stable login sessions
NAGRIKSEVA_AUTH_SECRET=replace_with_a_long_random_secret

# Required on Render if using PostgreSQL. Leave unset locally to use SQLite.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE

# Optional. Comma-separated trusted frontend origins.
# Keep * for easiest prototype testing; restrict it for production.
CORS_ORIGINS=*
